{
  "name": "@dinespot/utils",
  "version": "0.0.1",
  "private": true,
  "description": "Shared hooks, helpers and typed API client for DineSpot",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api.mjs",
      "require": "./dist/api.js",
      "types": "./dist/api.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/api.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts src/api.ts --format esm,cjs --dts --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@dinespot/tsconfig": "workspace:*",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@dinespot/types": "workspace:*",
    "@tanstack/query-core": "^5.45.0",
    "axios": "^1.7.0",
    "date-fns": "^3.6.0",
    "zod": "^3.23.0"
  }
}
