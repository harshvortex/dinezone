# ═══════════════════════════════════════════════════════════════
#  DineSpot — Master Environment Variables Reference
#  Copy this file to .env (gitignored) and fill in real values.
#  Variables are grouped by service / app.
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# APP — General
# ─────────────────────────────────────────
NODE_ENV=development                        # development | staging | production
APP_NAME=DineSpot
APP_VERSION=0.0.1

# ─────────────────────────────────────────
# API SERVER  (apps/api)
# ─────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
API_PREFIX=/api/v1

# Fastify logger level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─────────────────────────────────────────
# DATABASE — PostgreSQL + PostGIS  (apps/api)
# ─────────────────────────────────────────
DATABASE_URL=postgresql://dinespot:dinespot_secret@localhost:5432/dinespot_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dinespot_db
DATABASE_USER=dinespot
DATABASE_PASSWORD=dinespot_secret
DATABASE_SSL=false                          # set true in production
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT_MS=30000

# ─────────────────────────────────────────
# REDIS  (apps/api — sessions, queue, cache)
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                             # leave blank for local dev
REDIS_TLS=false                             # set true in production
REDIS_DB=0

# Queue DB index (BullMQ)
REDIS_QUEUE_DB=1

# ─────────────────────────────────────────
# AUTHENTICATION  (apps/api)
# ─────────────────────────────────────────
JWT_SECRET=CHANGE_ME_super_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_another_super_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=CHANGE_ME_cookie_signing_secret_32_chars_min
COOKIE_SECURE=false                         # set true in production (HTTPS only)

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# OAuth — Facebook (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/v1/auth/facebook/callback

# Clerk (Phone OTP authentication)
CLERK_SECRET_KEY=sk_test_CHANGE_ME
CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME          # used by frontend (Next.js / Expo)

# ─────────────────────────────────────────
# NEXT.JS WEB APP  (apps/web)
# All public vars MUST be prefixed NEXT_PUBLIC_
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DineSpot

# Mapbox (restaurant map discovery)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Maps (fallback / Places API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=             # Google Analytics 4
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Stripe publishable key (payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Web Push / VAPID
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────
# EXPO MOBILE APP  (apps/mobile)
# All vars MUST be prefixed EXPO_PUBLIC_
# ─────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_APP_NAME=DineSpot
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# EAS (Expo Application Services) — build & submit
EXPO_PROJECT_ID=
EXPO_ACCOUNT_NAME=

# ─────────────────────────────────────────
# PAYMENTS — Stripe  (apps/api)
# ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_CURRENCY=inr                        # ISO 4217 currency code

# ─────────────────────────────────────────
# EMAIL — Transactional  (apps/api)
# ─────────────────────────────────────────
# Provider: resend | sendgrid | ses | smtp
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM_ADDRESS=noreply@dinespot.app
EMAIL_FROM_NAME=DineSpot

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ─────────────────────────────────────────
# SMS / OTP  (apps/api)
# ─────────────────────────────────────────
SMS_PROVIDER=twilio                        # twilio | msg91 | aws_sns
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DNSPOT

# ─────────────────────────────────────────
# PUSH NOTIFICATIONS  (apps/api)
# ─────────────────────────────────────────
FCM_SERVER_KEY=                            # Firebase Cloud Messaging (Android)
APNS_KEY_ID=                               # Apple Push (iOS)
APNS_TEAM_ID=
APNS_KEY_PATH=./infra/certs/apns.p8
VAPID_PUBLIC_KEY=                          # Web Push
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dinespot.app

# Expo Push (managed Expo notifications)
EXPO_ACCESS_TOKEN=

# ─────────────────────────────────────────
# FILE STORAGE  (apps/api)
# ─────────────────────────────────────────
STORAGE_PROVIDER=s3                        # s3 | cloudinary | local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=dinespot-assets
AWS_S3_ENDPOINT=                           # custom endpoint for S3-compatible stores (MinIO, etc.)
AWS_CLOUDFRONT_URL=

# Cloudinary (alternative)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────
# GEOLOCATION  (apps/api)
# ─────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
MAPBOX_SECRET_TOKEN=

# PostGIS default search radius in metres
DEFAULT_SEARCH_RADIUS_M=5000

# ─────────────────────────────────────────
# RATE LIMITING  (apps/api)
# ─────────────────────────────────────────
RATE_LIMIT_MAX=100                         # requests per window
RATE_LIMIT_WINDOW_MS=60000                 # 1 minute

# ─────────────────────────────────────────
# CORS  (apps/api)
# ─────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─────────────────────────────────────────
# MONITORING & OBSERVABILITY
# ─────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dinespot-api

# ─────────────────────────────────────────
# INTERNAL SERVICES
# ─────────────────────────────────────────
# Admin secret for internal API calls (health checks, cron triggers)
INTERNAL_API_SECRET=CHANGE_ME_internal_secret

# BullMQ / background jobs
QUEUE_CONCURRENCY=5
