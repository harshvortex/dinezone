{
  "name": "@dinespot/api",
  "version": "0.0.1",
  "private": true,
  "description": "DineSpot API — Fastify + Prisma + PostgreSQL/PostGIS + Socket.IO",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format cjs --no-splitting --out-dir dist",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:format": "prisma format"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/backend": "^1.3.0",
    "@dinespot/types": "workspace:*",
    "@dinespot/utils": "workspace:*",
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.0",
    "cloudinary": "^2.10.0",
    "date-fns": "^3.6.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.0",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.7.0",
    "stripe": "^16.2.0",
    "twilio": "^6.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@dinespot/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "prisma": "^5.16.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
